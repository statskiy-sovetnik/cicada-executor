# Только секреты и то, что меняется между машинами.
# Адреса контрактов и тела RPC-URL лежат в src/config.ts.

# Ключ Alchemy — один на все сети, поддомены подставляются в конфигурации.
ALCHEMY_API_KEY=

# Ключ оператора: им подписываются вызовы redeemDelegations.
# На стадии 1 лежит в окружении; KMS — открытый вопрос 7.3 спецификации.
OPERATOR_PRIVATE_KEY=

# Кому разрешены запросы из браузера. По умолчанию все — аутентификации нет.
CORS_ORIGIN=*

# Где слушать и где держать базу.
PORT=8787
DB_PATH=./executor.sqlite
